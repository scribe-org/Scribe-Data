# tool: scribe-data
# All Russian (Q7737) verbs (Q24905) and the given forms.
# Enter this query at https://query.wikidata.org/.

PREFIX dct: <http://purl.org/dc/terms/>
PREFIX ontolex: <http://www.w3.org/ns/lemon/ontolex#>
PREFIX schema: <http://schema.org/>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wikibase: <http://wikiba.se/ontology#>

SELECT
  (replace(str(?lexeme), "http://www.wikidata.org/entity/", "") AS ?lexemeID)
  ?lastModified
  ?verb
  ?feminineIndicativePast
  ?masculineIndicativePast
  ?neuterIndicativePast
  ?indicativePresentThirdPersonSingular

WHERE {
  ?lexeme dct:language wd:Q7737;
    wikibase:lexicalCategory wd:Q24905;
    wikibase:lemma ?verb;
    schema:dateModified ?lastModified.

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?femIndPasForm.
    ?femIndPasForm ontolex:representation ?feminineIndicativePast;
    wikibase:grammaticalFeature wd:Q1775415, wd:Q682111, wd:Q1994301.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?masIndPasForm.
    ?masIndPasForm ontolex:representation ?masculineIndicativePast;
    wikibase:grammaticalFeature wd:Q499327, wd:Q682111, wd:Q1994301.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?neuIndPasForm.
    ?neuIndPasForm ontolex:representation ?neuterIndicativePast;
    wikibase:grammaticalFeature wd:Q1775461, wd:Q682111, wd:Q1994301.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?indPreThiPerSinForm.
    ?indPreThiPerSinForm ontolex:representation ?indicativePresentThirdPersonSingular;
    wikibase:grammaticalFeature wd:Q682111, wd:Q192613, wd:Q51929074, wd:Q110786.
  }
}
