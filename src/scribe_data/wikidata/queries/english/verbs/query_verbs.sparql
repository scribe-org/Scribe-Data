# tool: scribe-data
# All English (Q1860) verbs (Q24905) and the given forms.
# Enter this query at https://query.wikidata.org/.

PREFIX dct: <http://purl.org/dc/terms/>
PREFIX ontolex: <http://www.w3.org/ns/lemon/ontolex#>
PREFIX schema: <http://schema.org/>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wikibase: <http://wikiba.se/ontology#>

SELECT
  (replace(str(?lexeme), "http://www.wikidata.org/entity/", "") AS ?lexemeID)
  ?lastModified
  ?verb
  ?infinitive
  ?simplePresent
  ?simplePast
  ?presentParticiple
  ?pastParticiple
  ?simplePresentThirdPersonSingular

WHERE {
  ?lexeme dct:language wd:Q1860;
    wikibase:lexicalCategory wd:Q24905;
    wikibase:lemma ?verb;
    schema:dateModified ?lastModified.

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?iForm.
    ?iForm ontolex:representation ?infinitive;
    wikibase:grammaticalFeature wd:Q179230.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?sPForm.
    ?sPForm ontolex:representation ?simplePresent;
    wikibase:grammaticalFeature wd:Q3910936.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?sPForm.
    ?sPForm ontolex:representation ?simplePast;
    wikibase:grammaticalFeature wd:Q1392475.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?pPForm.
    ?pPForm ontolex:representation ?presentParticiple;
    wikibase:grammaticalFeature wd:Q192613, wd:Q814722.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?pPForm.
    ?pPForm ontolex:representation ?pastParticiple;
    wikibase:grammaticalFeature wd:Q1994301, wd:Q814722.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?sPTPSForm.
    ?sPTPSForm ontolex:representation ?simplePresentThirdPersonSingular;
    wikibase:grammaticalFeature wd:Q3910936, wd:Q51929074, wd:Q110786.
  }
}
