# tool: scribe-data
# All Spanish (Q1321) verbs (Q24905) and the given forms.
# Enter this query at https://query.wikidata.org/.

PREFIX dct: <http://purl.org/dc/terms/>
PREFIX ontolex: <http://www.w3.org/ns/lemon/ontolex#>
PREFIX schema: <http://schema.org/>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wikibase: <http://wikiba.se/ontology#>

SELECT
  (replace(str(?lexeme), "http://www.wikidata.org/entity/", "") AS ?lexemeID)
  ?lastModified
  ?verb
  ?indicativeFutureFirstPersonSingular
  ?indicativeFutureFirstPersonPlural
  ?indicativeFutureSecondPersonSingular
  ?indicativeFutureSecondPersonPlural
  ?indicativeFutureThirdPersonSingular
  ?indicativeFutureThirdPersonPlural

WHERE {
  ?lexeme dct:language wd:Q1321;
    wikibase:lexicalCategory wd:Q24905;
    wikibase:lemma ?verb;
    schema:dateModified ?lastModified.

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?iFFPSForm.
    ?iFFPSForm ontolex:representation ?indicativeFutureFirstPersonSingular;
    wikibase:grammaticalFeature wd:Q682111, wd:Q501405, wd:Q21714344, wd:Q110786.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?iFFPPForm.
    ?iFFPPForm ontolex:representation ?indicativeFutureFirstPersonPlural;
    wikibase:grammaticalFeature wd:Q682111, wd:Q501405, wd:Q21714344, wd:Q146786.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?iFSPSForm.
    ?iFSPSForm ontolex:representation ?indicativeFutureSecondPersonSingular;
    wikibase:grammaticalFeature wd:Q682111, wd:Q501405, wd:Q51929049, wd:Q110786.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?iFSPPForm.
    ?iFSPPForm ontolex:representation ?indicativeFutureSecondPersonPlural;
    wikibase:grammaticalFeature wd:Q682111, wd:Q501405, wd:Q51929049, wd:Q146786.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?iFTPSForm.
    ?iFTPSForm ontolex:representation ?indicativeFutureThirdPersonSingular;
    wikibase:grammaticalFeature wd:Q682111, wd:Q501405, wd:Q51929074, wd:Q110786.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?iFTPPForm.
    ?iFTPPForm ontolex:representation ?indicativeFutureThirdPersonPlural;
    wikibase:grammaticalFeature wd:Q682111, wd:Q501405, wd:Q51929074, wd:Q146786.
  }
}
