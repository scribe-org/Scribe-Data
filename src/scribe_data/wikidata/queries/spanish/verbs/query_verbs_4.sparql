# tool: scribe-data
# All Spanish (Q1321) verbs (Q24905) and the given forms.
# Enter this query at https://query.wikidata.org/.

PREFIX dct: <http://purl.org/dc/terms/>
PREFIX ontolex: <http://www.w3.org/ns/lemon/ontolex#>
PREFIX schema: <http://schema.org/>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wikibase: <http://wikiba.se/ontology#>

SELECT
  (replace(str(?lexeme), "http://www.wikidata.org/entity/", "") AS ?lexemeID)
  ?lastModified
  ?verb
  ?preteriteFirstPersonSingular
  ?preteriteFirstPersonPlural
  ?preteriteSecondPersonSingular
  ?preteriteSecondPersonPlural
  ?preteriteThirdPersonSingular
  ?preteriteThirdPersonPlural

WHERE {
  ?lexeme dct:language wd:Q1321;
    wikibase:lexicalCategory wd:Q24905;
    wikibase:lemma ?verb;
    schema:dateModified ?lastModified.

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?preFirPerSinForm.
    ?preFirPerSinForm ontolex:representation ?preteriteFirstPersonSingular;
    wikibase:grammaticalFeature wd:Q442485, wd:Q21714344, wd:Q110786.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?preFirPerPluForm.
    ?preFirPerPluForm ontolex:representation ?preteriteFirstPersonPlural;
    wikibase:grammaticalFeature wd:Q442485, wd:Q21714344, wd:Q146786.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?preSecPerSinForm.
    ?preSecPerSinForm ontolex:representation ?preteriteSecondPersonSingular;
    wikibase:grammaticalFeature wd:Q442485, wd:Q51929049, wd:Q110786.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?preSecPerPluForm.
    ?preSecPerPluForm ontolex:representation ?preteriteSecondPersonPlural;
    wikibase:grammaticalFeature wd:Q442485, wd:Q51929049, wd:Q146786.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?preThiPerSinForm.
    ?preThiPerSinForm ontolex:representation ?preteriteThirdPersonSingular;
    wikibase:grammaticalFeature wd:Q442485, wd:Q51929074, wd:Q110786.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?preThiPerPluForm.
    ?preThiPerPluForm ontolex:representation ?preteriteThirdPersonPlural;
    wikibase:grammaticalFeature wd:Q442485, wd:Q51929074, wd:Q146786.
  }
}
