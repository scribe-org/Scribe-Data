# tool: scribe-data
# All Spanish (Q1321) nouns (Q1084) and the given forms.
# Enter this query at https://query.wikidata.org/.

PREFIX dct: <http://purl.org/dc/terms/>
PREFIX ontolex: <http://www.w3.org/ns/lemon/ontolex#>
PREFIX schema: <http://schema.org/>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wikibase: <http://wikiba.se/ontology#>

SELECT
  (replace(str(?lexeme), "http://www.wikidata.org/entity/", "") AS ?lexemeID)
  ?lastModified
  ?noun
  ?feminineSingular
  ?femininePlural
  ?masculineSingular
  ?masculinePlural

WHERE {
  ?lexeme dct:language wd:Q1321;
    wikibase:lexicalCategory wd:Q1084;
    wikibase:lemma ?noun;
    schema:dateModified ?lastModified.

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?fSForm.
    ?fSForm ontolex:representation ?feminineSingular;
    wikibase:grammaticalFeature wd:Q1775415, wd:Q110786.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?fPForm.
    ?fPForm ontolex:representation ?femininePlural;
    wikibase:grammaticalFeature wd:Q1775415, wd:Q146786.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?mSForm.
    ?mSForm ontolex:representation ?masculineSingular;
    wikibase:grammaticalFeature wd:Q499327, wd:Q110786.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?mPForm.
    ?mPForm ontolex:representation ?masculinePlural;
    wikibase:grammaticalFeature wd:Q499327, wd:Q146786.
  }
}
