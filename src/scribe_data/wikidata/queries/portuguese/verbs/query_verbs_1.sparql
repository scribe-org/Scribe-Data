# tool: scribe-data
# All Portuguese (Q5146) verbs (Q24905) and the given forms.
# Enter this query at https://query.wikidata.org/.

PREFIX dct: <http://purl.org/dc/terms/>
PREFIX ontolex: <http://www.w3.org/ns/lemon/ontolex#>
PREFIX schema: <http://schema.org/>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wikibase: <http://wikiba.se/ontology#>

SELECT
  (replace(str(?lexeme), "http://www.wikidata.org/entity/", "") AS ?lexemeID)
  ?lastModified
  ?verb
  ?indicativePastImperfectFirstPersonSingular
  ?indicativePastImperfectFirstPersonPlural
  ?indicativePastImperfectSecondPersonSingular
  ?indicativePastImperfectSecondPersonPlural
  ?indicativePastImperfectThirdPersonSingular
  ?indicativePastImperfectThirdPersonPlural

WHERE {
  ?lexeme dct:language wd:Q5146;
    wikibase:lexicalCategory wd:Q24905;
    wikibase:lemma ?verb;
    schema:dateModified ?lastModified.

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?iPIFPSForm.
    ?iPIFPSForm ontolex:representation ?indicativePastImperfectFirstPersonSingular;
    wikibase:grammaticalFeature wd:Q682111, wd:Q1994301, wd:Q108524486, wd:Q21714344, wd:Q110786.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?iPIFPPForm.
    ?iPIFPPForm ontolex:representation ?indicativePastImperfectFirstPersonPlural;
    wikibase:grammaticalFeature wd:Q682111, wd:Q1994301, wd:Q108524486, wd:Q21714344, wd:Q146786.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?iPISPSForm.
    ?iPISPSForm ontolex:representation ?indicativePastImperfectSecondPersonSingular;
    wikibase:grammaticalFeature wd:Q682111, wd:Q1994301, wd:Q108524486, wd:Q51929049, wd:Q110786.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?iPISPPForm.
    ?iPISPPForm ontolex:representation ?indicativePastImperfectSecondPersonPlural;
    wikibase:grammaticalFeature wd:Q682111, wd:Q1994301, wd:Q108524486, wd:Q51929049, wd:Q146786.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?iPITPSForm.
    ?iPITPSForm ontolex:representation ?indicativePastImperfectThirdPersonSingular;
    wikibase:grammaticalFeature wd:Q682111, wd:Q1994301, wd:Q108524486, wd:Q51929074, wd:Q110786.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?iPITPPForm.
    ?iPITPPForm ontolex:representation ?indicativePastImperfectThirdPersonPlural;
    wikibase:grammaticalFeature wd:Q682111, wd:Q1994301, wd:Q108524486, wd:Q51929074, wd:Q146786.
  }
}
