# tool: scribe-data
# All Portuguese (Q5146) verbs (Q24905) and the given forms.
# Enter this query at https://query.wikidata.org/.

PREFIX dct: <http://purl.org/dc/terms/>
PREFIX ontolex: <http://www.w3.org/ns/lemon/ontolex#>
PREFIX schema: <http://schema.org/>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wikibase: <http://wikiba.se/ontology#>

SELECT
  (replace(str(?lexeme), "http://www.wikidata.org/entity/", "") AS ?lexemeID)
  ?lastModified
  ?verb
  ?indicativePluperfectFirstPersonSingular
  ?indicativePluperfectFirstPersonPlural
  ?indicativePluperfectSecondPersonSingular
  ?indicativePluperfectSecondPersonPlural
  ?indicativePluperfectThirdPersonSingular
  ?indicativePluperfectThirdPersonPlural

WHERE {
  ?lexeme dct:language wd:Q5146;
    wikibase:lexicalCategory wd:Q24905;
    wikibase:lemma ?verb;
    schema:dateModified ?lastModified.

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?indPluFirPerSinForm.
    ?indPluFirPerSinForm ontolex:representation ?indicativePluperfectFirstPersonSingular;
    wikibase:grammaticalFeature wd:Q682111, wd:Q623742, wd:Q21714344, wd:Q110786.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?indPluFirPerPluForm.
    ?indPluFirPerPluForm ontolex:representation ?indicativePluperfectFirstPersonPlural;
    wikibase:grammaticalFeature wd:Q682111, wd:Q623742, wd:Q21714344, wd:Q146786.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?indPluSecPerSinForm.
    ?indPluSecPerSinForm ontolex:representation ?indicativePluperfectSecondPersonSingular;
    wikibase:grammaticalFeature wd:Q682111, wd:Q623742, wd:Q51929049, wd:Q110786.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?indPluSecPerPluForm.
    ?indPluSecPerPluForm ontolex:representation ?indicativePluperfectSecondPersonPlural;
    wikibase:grammaticalFeature wd:Q682111, wd:Q623742, wd:Q51929049, wd:Q146786.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?indPluThiPerSinForm.
    ?indPluThiPerSinForm ontolex:representation ?indicativePluperfectThirdPersonSingular;
    wikibase:grammaticalFeature wd:Q682111, wd:Q623742, wd:Q51929074, wd:Q110786.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?indPluThiPerPluForm.
    ?indPluThiPerPluForm ontolex:representation ?indicativePluperfectThirdPersonPlural;
    wikibase:grammaticalFeature wd:Q682111, wd:Q623742, wd:Q51929074, wd:Q146786.
  }
}
