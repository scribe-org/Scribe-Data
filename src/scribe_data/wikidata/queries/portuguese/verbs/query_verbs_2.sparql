# tool: scribe-data
# All Portuguese (Q5146) verbs (Q24905) and the given forms.
# Enter this query at https://query.wikidata.org/.

PREFIX dct: <http://purl.org/dc/terms/>
PREFIX ontolex: <http://www.w3.org/ns/lemon/ontolex#>
PREFIX schema: <http://schema.org/>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wikibase: <http://wikiba.se/ontology#>

SELECT
  (replace(str(?lexeme), "http://www.wikidata.org/entity/", "") AS ?lexemeID)
  ?lastModified
  ?verb
  ?indicativePastPerfectFirstPersonSingular
  ?indicativePastPerfectFirstPersonPlural
  ?indicativePastPerfectSecondPersonSingular
  ?indicativePastPerfectSecondPersonPlural
  ?indicativePastPerfectThirdPersonSingular
  ?indicativePastPerfectThirdPersonPlural

WHERE {
  ?lexeme dct:language wd:Q5146;
    wikibase:lexicalCategory wd:Q24905;
    wikibase:lemma ?verb;
    schema:dateModified ?lastModified.

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?indPasPerFirPerSinForm.
    ?indPasPerFirPerSinForm ontolex:representation ?indicativePastPerfectFirstPersonSingular;
    wikibase:grammaticalFeature wd:Q682111, wd:Q1994301, wd:Q625420, wd:Q21714344, wd:Q110786.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?indPasPerFirPerPluForm.
    ?indPasPerFirPerPluForm ontolex:representation ?indicativePastPerfectFirstPersonPlural;
    wikibase:grammaticalFeature wd:Q682111, wd:Q1994301, wd:Q625420, wd:Q21714344, wd:Q146786.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?indPasPerSecPerSinForm.
    ?indPasPerSecPerSinForm ontolex:representation ?indicativePastPerfectSecondPersonSingular;
    wikibase:grammaticalFeature wd:Q682111, wd:Q1994301, wd:Q625420, wd:Q51929049, wd:Q110786.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?indPasPerSecPerPluForm.
    ?indPasPerSecPerPluForm ontolex:representation ?indicativePastPerfectSecondPersonPlural;
    wikibase:grammaticalFeature wd:Q682111, wd:Q1994301, wd:Q625420, wd:Q51929049, wd:Q146786.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?indPasPerThiPerSinForm.
    ?indPasPerThiPerSinForm ontolex:representation ?indicativePastPerfectThirdPersonSingular;
    wikibase:grammaticalFeature wd:Q682111, wd:Q1994301, wd:Q625420, wd:Q51929074, wd:Q110786.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?indPasPerThiPerPluForm.
    ?indPasPerThiPerPluForm ontolex:representation ?indicativePastPerfectThirdPersonPlural;
    wikibase:grammaticalFeature wd:Q682111, wd:Q1994301, wd:Q625420, wd:Q51929074, wd:Q146786.
  }
}
