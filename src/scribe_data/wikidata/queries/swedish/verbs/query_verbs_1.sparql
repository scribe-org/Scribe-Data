# tool: scribe-data
# All Swedish (Q9027) verbs (Q24905) and the given forms.
# Enter this query at https://query.wikidata.org/.

PREFIX dct: <http://purl.org/dc/terms/>
PREFIX ontolex: <http://www.w3.org/ns/lemon/ontolex#>
PREFIX schema: <http://schema.org/>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wikibase: <http://wikiba.se/ontology#>

SELECT
  (replace(str(?lexeme), "http://www.wikidata.org/entity/", "") AS ?lexemeID)
  ?lastModified
  ?verb
  ?activeInfinitive
  ?activePresent
  ?activePreterite
  ?activeSupine

WHERE {
  ?lexeme dct:language wd:Q9027;
    wikibase:lexicalCategory wd:Q24905;
    wikibase:lemma ?verb;
    schema:dateModified ?lastModified.

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?aIForm.
    ?aIForm ontolex:representation ?activeInfinitive;
    wikibase:grammaticalFeature wd:Q1317831, wd:Q179230.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?aPForm.
    ?aPForm ontolex:representation ?activePresent;
    wikibase:grammaticalFeature wd:Q1317831, wd:Q192613.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?aPForm.
    ?aPForm ontolex:representation ?activePreterite;
    wikibase:grammaticalFeature wd:Q1317831, wd:Q442485.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?aSForm.
    ?aSForm ontolex:representation ?activeSupine;
    wikibase:grammaticalFeature wd:Q1317831, wd:Q548470.
  }
}
