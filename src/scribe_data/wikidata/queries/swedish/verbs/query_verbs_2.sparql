# tool: scribe-data
# All Swedish (Q9027) verbs (Q24905) and the given forms.
# Enter this query at https://query.wikidata.org/.

PREFIX dct: <http://purl.org/dc/terms/>
PREFIX ontolex: <http://www.w3.org/ns/lemon/ontolex#>
PREFIX schema: <http://schema.org/>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wikibase: <http://wikiba.se/ontology#>

SELECT
  (replace(str(?lexeme), "http://www.wikidata.org/entity/", "") AS ?lexemeID)
  ?lastModified
  ?verb
  ?passiveInfinitive
  ?passivePresent
  ?passivePreterite
  ?passiveSupine

WHERE {
  ?lexeme dct:language wd:Q9027;
    wikibase:lexicalCategory wd:Q24905;
    wikibase:lemma ?verb;
    schema:dateModified ?lastModified.

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?pasInfForm.
    ?pasInfForm ontolex:representation ?passiveInfinitive;
    wikibase:grammaticalFeature wd:Q1194697, wd:Q179230.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?pasPreForm.
    ?pasPreForm ontolex:representation ?passivePresent;
    wikibase:grammaticalFeature wd:Q1194697, wd:Q192613.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?pasPreForm.
    ?pasPreForm ontolex:representation ?passivePreterite;
    wikibase:grammaticalFeature wd:Q1194697, wd:Q442485.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?pasSupForm.
    ?pasSupForm ontolex:representation ?passiveSupine;
    wikibase:grammaticalFeature wd:Q1194697, wd:Q548470.
  }
}
