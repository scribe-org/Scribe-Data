# tool: scribe-data
# All French (Q150) verbs (Q24905) and the given forms.
# Enter this query at https://query.wikidata.org/.

PREFIX dct: <http://purl.org/dc/terms/>
PREFIX ontolex: <http://www.w3.org/ns/lemon/ontolex#>
PREFIX schema: <http://schema.org/>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wikibase: <http://wikiba.se/ontology#>

SELECT
  (replace(str(?lexeme), "http://www.wikidata.org/entity/", "") AS ?lexemeID)
  ?lastModified
  ?verb
  ?indicativeSimpleFutureFirstPersonSingular
  ?indicativeSimpleFutureFirstPersonPlural
  ?indicativeSimpleFutureSecondPersonSingular
  ?indicativeSimpleFutureSecondPersonPlural
  ?indicativeSimpleFutureThirdPersonSingular
  ?indicativeSimpleFutureThirdPersonPlural

WHERE {
  ?lexeme dct:language wd:Q150;
    wikibase:lexicalCategory wd:Q24905;
    wikibase:lemma ?verb;
    schema:dateModified ?lastModified.

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?iSFFPSForm.
    ?iSFFPSForm ontolex:representation ?indicativeSimpleFutureFirstPersonSingular;
    wikibase:grammaticalFeature wd:Q682111, wd:Q1475560, wd:Q21714344, wd:Q110786.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?iSFFPPForm.
    ?iSFFPPForm ontolex:representation ?indicativeSimpleFutureFirstPersonPlural;
    wikibase:grammaticalFeature wd:Q682111, wd:Q1475560, wd:Q21714344, wd:Q146786.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?iSFSPSForm.
    ?iSFSPSForm ontolex:representation ?indicativeSimpleFutureSecondPersonSingular;
    wikibase:grammaticalFeature wd:Q682111, wd:Q1475560, wd:Q51929049, wd:Q110786.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?iSFSPPForm.
    ?iSFSPPForm ontolex:representation ?indicativeSimpleFutureSecondPersonPlural;
    wikibase:grammaticalFeature wd:Q682111, wd:Q1475560, wd:Q51929049, wd:Q146786.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?iSFTPSForm.
    ?iSFTPSForm ontolex:representation ?indicativeSimpleFutureThirdPersonSingular;
    wikibase:grammaticalFeature wd:Q682111, wd:Q1475560, wd:Q51929074, wd:Q110786.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?iSFTPPForm.
    ?iSFTPPForm ontolex:representation ?indicativeSimpleFutureThirdPersonPlural;
    wikibase:grammaticalFeature wd:Q682111, wd:Q1475560, wd:Q51929074, wd:Q146786.
  }
}
