# tool: scribe-data
# All German (Q188) verbs (Q24905) and the given forms.
# Enter this query at https://query.wikidata.org/.

PREFIX dct: <http://purl.org/dc/terms/>
PREFIX ontolex: <http://www.w3.org/ns/lemon/ontolex#>
PREFIX schema: <http://schema.org/>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wikibase: <http://wikiba.se/ontology#>

SELECT
  (replace(str(?lexeme), "http://www.wikidata.org/entity/", "") AS ?lexemeID)
  ?lastModified
  ?verb
  ?indicativePresentFirstPersonSingular
  ?indicativePresentFirstPersonPlural
  ?indicativePresentSecondPersonSingular
  ?indicativePresentSecondPersonPlural
  ?indicativePresentThirdPersonSingular
  ?indicativePresentThirdPersonPlural

WHERE {
  ?lexeme dct:language wd:Q188;
    wikibase:lexicalCategory wd:Q24905;
    wikibase:lemma ?verb;
    schema:dateModified ?lastModified.

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?iPFPSForm.
    ?iPFPSForm ontolex:representation ?indicativePresentFirstPersonSingular;
    wikibase:grammaticalFeature wd:Q682111, wd:Q192613, wd:Q21714344, wd:Q110786.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?iPFPPForm.
    ?iPFPPForm ontolex:representation ?indicativePresentFirstPersonPlural;
    wikibase:grammaticalFeature wd:Q682111, wd:Q192613, wd:Q21714344, wd:Q146786.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?iPSPSForm.
    ?iPSPSForm ontolex:representation ?indicativePresentSecondPersonSingular;
    wikibase:grammaticalFeature wd:Q682111, wd:Q192613, wd:Q51929049, wd:Q110786.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?iPSPPForm.
    ?iPSPPForm ontolex:representation ?indicativePresentSecondPersonPlural;
    wikibase:grammaticalFeature wd:Q682111, wd:Q192613, wd:Q51929049, wd:Q146786.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?iPTPSForm.
    ?iPTPSForm ontolex:representation ?indicativePresentThirdPersonSingular;
    wikibase:grammaticalFeature wd:Q682111, wd:Q192613, wd:Q51929074, wd:Q110786.
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?iPTPPForm.
    ?iPTPPForm ontolex:representation ?indicativePresentThirdPersonPlural;
    wikibase:grammaticalFeature wd:Q682111, wd:Q192613, wd:Q51929074, wd:Q146786.
  }
}
