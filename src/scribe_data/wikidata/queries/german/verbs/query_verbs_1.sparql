# tool: scribe-data
# All  (Q188) verbs (Q24905) and the given forms.
# Enter this query at https://query.wikidata.org/.

SELECT
  (replace(str(?lexeme), "http://www.wikidata.org/entity/", "") AS ?lexemeID)
  ?lastModified
  ?verb
  ?auxiliaryVerb
  ?pastParticiple

WHERE {
  ?lexeme dct:language wd:Q188;
    wikibase:lexicalCategory wd:Q24905;
    wikibase:lemma ?verb;
    schema:dateModified ?lastModified.

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?auxiliaryVerbForm.
    ?auxiliaryVerbForm ontolex:representation ?auxiliaryVerb;
    wikibase:grammaticalFeature .
  }

  OPTIONAL {
    ?lexeme ontolex:lexicalForm ?pastParticipleForm.
    ?pastParticipleForm ontolex:representation ?pastParticiple;
    wikibase:grammaticalFeature wd:Q1994301, wd:Q814722.
  }
}
